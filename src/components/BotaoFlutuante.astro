---
/** Botão fixo de WhatsApp no canto da tela, com o texto pronto da página. */
import { linkWhatsApp, type PaginaId } from '../config';
import IconeWhatsApp from './IconeWhatsApp.astro';
interface Props { pagina: PaginaId }
const href = linkWhatsApp(Astro.props.pagina);
const externo = href.startsWith('http');
---
<a class="flutuante" href={href} data-whatsapp={Astro.props.pagina} aria-label="Conversar no WhatsApp" {...(externo ? { target: '_blank', rel: 'noopener' } : {})}>
  <IconeWhatsApp />
</a>
<style>
  .flutuante {
    position: fixed; z-index: 55; right: max(18px, env(safe-area-inset-right, 0px)); bottom: max(18px, env(safe-area-inset-bottom, 0px));
    width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center;
    background: #25d366; color: #fff; box-shadow: 0 10px 28px -8px rgb(18 161 80 / 0.7);
    transition: transform 0.15s ease;
  }
  .flutuante:hover { color: #fff; transform: scale(1.06); }
  .flutuante :global(svg) { width: 30px; height: 30px; }
</style>
