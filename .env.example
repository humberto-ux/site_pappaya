# Copie para .env e preencha. Nada aqui é segredo: todas as variáveis
# PUBLIC_ vão para o navegador. Nunca coloque a chave da API da Valentina aqui;
# ela fica nas credenciais do n8n.

# Número de WhatsApp comercial, só dígitos, com DDI 55 e DDD. Ex.: 5511999999999
PUBLIC_WHATSAPP=

# URL de produção do nó Webhook (POST) do n8n que recebe o formulário
PUBLIC_FORM_ENDPOINT=

# Contêiner do Google Tag Manager (o site atual usa GTM-M4WV8MVX)
PUBLIC_GTM_ID=GTM-M4WV8MVX

# true = esconde todas as frases marcadas [prova pendente] (use na publicação)
# false = mostra as frases com a etiqueta "prova pendente" (use na revisão)
PUBLIC_OCULTAR_PENDENTES=false
