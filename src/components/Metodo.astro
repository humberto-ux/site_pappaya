---
import Icone from './Icone.astro';
const etapas = [
  { nome: 'Diagnóstico', texto: 'Entendemos onde o processo perde informação, tempo ou responsabilidade.', icone: 'pergunta' },
  { nome: 'Desenho', texto: 'Definimos quem responde o quê e as regras.', icone: 'rota' },
  { nome: 'Implantação', texto: 'Configuramos a Valentina e as integrações.', icone: 'engrenagem' },
  { nome: 'Acompanhamento', texto: 'Ficamos até a equipe usar.', icone: 'check' },
] as const;
---
<ol class="metodo">
  {etapas.map((e, i) => (
    <li class="revelar">
      <div class="metodo__topo"><span class="metodo__icone"><Icone nome={e.icone} /></span><span class="metodo__n">0{i + 1}</span></div>
      <h3>{e.nome}</h3>
      <p>{e.texto}</p>
    </li>
  ))}
</ol>
<style>
  .metodo { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .metodo li { position: relative; background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio-lg); padding: 24px; }
  .metodo li:not(:last-child)::after { content: ''; position: absolute; top: 46px; right: -17px; width: 18px; height: 1.5px; background: var(--linha-forte); }
  .metodo__topo { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; }
  .metodo__icone { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--verde-claro); color: var(--verde); }
  .metodo__icone :global(svg) { width: 22px; height: 22px; }
  .metodo__n { font-family: var(--fonte-titulo); font-weight: 600; color: var(--tinta-3); }
  .metodo h3 { margin-bottom: 8px; }
  .metodo p { color: var(--tinta-2); font-size: 0.98rem; }
  @media (max-width: 960px) { .metodo { grid-template-columns: 1fr 1fr; } .metodo li::after { display: none; } }
  @media (max-width: 520px) { .metodo { grid-template-columns: 1fr; } }
</style>
