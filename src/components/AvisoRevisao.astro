---
import { ocultarPendentes } from '../config';
---
{!ocultarPendentes && (
  <div class="revisao" role="note">
    <span class="revisao__selo">Versão de revisão</span>
    Trechos sublinhados com <span class="pendente__etiqueta" aria-hidden="true">P</span> dependem de prova e somem na publicação.
  </div>
)}
<style>
  .revisao { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px 10px; padding: 8px 16px; background: var(--ambar-claro); color: var(--ambar); font-size: 0.82rem; text-align: center; }
  .revisao__selo { font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; }
</style>
