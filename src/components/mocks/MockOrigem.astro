---
/** Contato mostrando a origem (campanha, anúncio ou página). */
import Janela from './Janela.astro';
const linhas = [
  ['Marina Lopes', 'Meta Ads', 'Residencial Jardins · 2 quartos', 'papaya'],
  ['Carlos Mendes', 'Google Ads', 'Pesquisa "apartamento centro"', 'verde'],
  ['Luciana Ferraz', 'Site', 'Página de Hotelaria', ''],
  ['Ricardo Nunes', 'Instagram', 'Post orgânico · feriado', 'ambar'],
];
---
<Janela titulo="Contatos de hoje">
  <table class="mo">
    <thead><tr><th>Contato</th><th>Canal</th><th>Campanha ou página</th></tr></thead>
    <tbody>
      {linhas.map(([n, c, camp, cor]) => (
        <tr><td><strong>{n}</strong></td><td><span class:list={['m-tag', cor && `m-tag--${cor}`]}>{c}</span></td><td>{camp}</td></tr>
      ))}
    </tbody>
  </table>
</Janela>
<style>
  .mo { width: 100%; border-collapse: collapse; }
  .mo th { text-align: left; font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--m-texto-2); padding: 12px 14px 8px; border-bottom: 1px solid var(--m-linha); }
  .mo td { padding: 12px 14px; border-bottom: 1px solid var(--m-linha); font-size: 12.5px; color: var(--m-texto-2); }
  .mo td strong { color: var(--m-texto); }
  .mo tr:first-child td { background: #fffaf6; }
  @media (max-width: 520px) { .mo th:last-child, .mo td:last-child { display: none; } }
</style>
