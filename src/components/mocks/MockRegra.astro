---
/** Regra de distribuição e o momento da transferência para uma pessoa. */
import Janela from './Janela.astro';
---
<Janela titulo="Regras de distribuição">
  <div class="mr">
    <div class="mr__regra">
      <div class="mr__passo"><span class="mr__se">Se</span>empreendimento <b>é</b> <span class="m-tag m-tag--papaya">Residencial Jardins</span></div>
      <div class="mr__passo"><span class="mr__se">e</span>IA classificou interesse como <span class="m-tag">Quente</span></div>
      <div class="mr__passo"><span class="mr__entao">Então</span>enviar para <span class="m-tag m-tag--verde">Plantão Jardins</span> em rodízio</div>
      <div class="mr__passo"><span class="mr__senao">Sem resposta em 15 min</span>repassar para <span class="m-tag">Imobiliária parceira</span></div>
    </div>
    <div class="mr__evento">
      <span class="m-avatar">RA</span>
      <div><strong>Rafael assumiu a conversa</strong><span>A IA passou o resumo e saiu da conversa · 19:44</span></div>
    </div>
  </div>
</Janela>
<style>
  .mr { padding: 14px; background: var(--m-suave); display: flex; flex-direction: column; gap: 12px; }
  .mr__regra { background: #fff; border: 1px solid var(--m-linha); border-radius: 12px; padding: 6px 0; }
  .mr__passo { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 9px 14px; font-size: 12.5px; }
  .mr__passo + .mr__passo { border-top: 1px dashed var(--m-linha); }
  .mr__passo b { font-weight: 600; }
  .mr__se, .mr__entao, .mr__senao { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 7px; border-radius: 6px; background: var(--m-suave); color: var(--m-texto-2); }
  .mr__entao { background: var(--verde-claro); color: var(--verde); }
  .mr__senao { background: var(--ambar-claro); color: var(--ambar); }
  .mr__evento { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid #cfe6da; border-left: 3px solid var(--verde); border-radius: 12px; padding: 10px 12px; }
  .mr__evento strong { display: block; font-size: 12.5px; }
  .mr__evento span:not(.m-avatar) { font-size: 11.5px; color: var(--m-texto-2); }
</style>
