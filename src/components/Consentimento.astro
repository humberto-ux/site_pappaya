---
/**
 * Aviso de cookies. O Google Tag Manager (e o GA4 dentro dele) só carrega
 * depois que o visitante aceita. Sem PUBLIC_GTM_ID, o aviso não aparece.
 */
import { gtmId } from '../config';
---
{gtmId && (
  <div class="cookies" data-cookies hidden role="region" aria-label="Aviso de cookies">
    <p>Usamos cookies de medição para entender como o site é usado. Veja a <a href="/privacidade">Política de Privacidade</a>.</p>
    <div class="cookies__botoes">
      <button class="botao botao--contorno" type="button" data-cookies-recusar>Recusar</button>
      <button class="botao" type="button" data-cookies-aceitar>Aceitar</button>
    </div>
  </div>
)}
<script>
  const CHAVE = 'pappaya-cookies';
  const id = (window as any).pappayaGtm as string | undefined;
  const caixa = document.querySelector<HTMLElement>('[data-cookies]');

  function ler() { try { return localStorage.getItem(CHAVE); } catch { return null; } }
  function gravar(v: string) { try { localStorage.setItem(CHAVE, v); } catch { /* navegação privada */ } }

  function carregarGtm() {
    if (!id || (window as any).__gtmCarregado) return;
    (window as any).__gtmCarregado = true;
    const dl = ((window as any).dataLayer = (window as any).dataLayer || []);
    dl.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(id)}`;
    document.head.appendChild(s);
  }

  const escolha = ler();
  if (escolha === 'aceito') carregarGtm();
  else if (!escolha && caixa) caixa.hidden = false;

  caixa?.querySelector('[data-cookies-aceitar]')?.addEventListener('click', () => {
    gravar('aceito'); caixa.hidden = true; carregarGtm();
  });
  caixa?.querySelector('[data-cookies-recusar]')?.addEventListener('click', () => {
    gravar('recusado'); caixa.hidden = true;
  });
</script>
<style>
  .cookies {
    position: fixed; z-index: 60; left: 16px; right: 16px; bottom: 16px;
    max-width: 560px; margin-inline: auto;
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
    background: var(--branco); border: 1px solid var(--linha); border-radius: var(--raio-lg);
    box-shadow: var(--sombra-lg); padding: 18px 20px; font-size: 0.92rem; color: var(--tinta-2);
  }
  .cookies[hidden] { display: none; }
  .cookies p { flex: 1 1 260px; }
  .cookies__botoes { display: flex; gap: 8px; }
  .cookies .botao { min-height: 42px; padding: 8px 18px; font-size: 0.92rem; }
</style>
