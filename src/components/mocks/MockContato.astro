---
/** Contato com origem, resumo da IA e responsável atribuído (abertura da página inicial). */
import Janela from './Janela.astro';
interface Props { marcas?: boolean }
const { marcas = true } = Astro.props;
---
<Janela titulo="Contato · Marina Lopes" class="mc">
  <div class="mc__grade">
    <div class="m-chat mc__chat">
      <div class="m-balao m-balao--cliente">Oi! Vi o anúncio do Residencial Jardins. Quero saber do apartamento de 2 quartos.<small>19:42</small></div>
      <div class="m-balao m-balao--ia"><em>VALENTINA · IA</em>Olá, Marina! Você pretende financiar ou pagar à vista? E qual faixa de valor está buscando?<small>19:42</small></div>
      <div class="m-balao m-balao--cliente">Financiar. Até uns 450 mil.<small>19:43</small></div>
      <div class="m-sistema">Conversa transferida para Rafael · corretor de plantão</div>
    </div>
    <div class="mc__ficha">
      <div class="mc__pessoa">
        <span class="m-avatar m-avatar--papaya">ML</span>
        <div><strong>Marina Lopes</strong><span>(11) 9•••• ••21</span></div>
      </div>
      <div class="mc__campo">
        <span class="m-rotulo">{marcas && <i class="m-num">1</i>}Origem</span>
        <div class="mc__tags"><span class="m-tag m-tag--papaya">Anúncio · Residencial Jardins</span><span class="m-tag">WhatsApp da unidade Centro</span></div>
      </div>
      <div class="m-caixa m-ia">
        <span class="m-rotulo">{marcas && <i class="m-num">2</i>}Resumo da IA</span>
        <p>Interesse em apartamento de 2 quartos no Residencial Jardins. Vai financiar, faixa de até R$ 450 mil. Pediu planta e condições.</p>
      </div>
      <div class="mc__linha">
        <div class="mc__campo">
          <span class="m-rotulo">{marcas && <i class="m-num">3</i>}Responsável</span>
          <span class="mc__resp"><span class="m-avatar">RA</span>Rafael Antunes</span>
        </div>
        <div class="mc__campo">
          <span class="m-rotulo">Próximo passo</span>
          <span class="m-tag m-tag--verde">Retornar até 19:58</span>
        </div>
      </div>
    </div>
  </div>
</Janela>
<style>
  .mc__grade { display: grid; grid-template-columns: 1fr 1.1fr; min-height: 340px; }
  .mc__chat { justify-content: flex-end; border-right: 1px solid var(--m-linha); }
  .mc__ficha { display: flex; flex-direction: column; gap: 14px; padding: 16px; }
  .mc__pessoa { display: flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid var(--m-linha); }
  .mc__pessoa .m-avatar { width: 38px; height: 38px; font-size: 13px; }
  .mc__pessoa strong { display: block; font-size: 15px; }
  .mc__pessoa span:not(.m-avatar) { font-size: 12px; color: var(--m-texto-2); }
  .m-num { display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: 6px; border-radius: 50%; background: var(--papaya); color: var(--tinta); font: normal 700 10.5px/1 var(--fonte-texto); letter-spacing: 0; box-shadow: 0 0 0 3px rgb(242 98 46 / 0.2); vertical-align: middle; }
  .m-ia .m-rotulo .m-num { order: -1; }
  .mc__campo { display: flex; flex-direction: column; gap: 6px; }
  .mc__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .m-ia p { margin-top: 6px; font-size: 12.5px; color: var(--m-texto); }
  .mc__linha { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mc__resp { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .mc__resp .m-avatar { width: 24px; height: 24px; font-size: 10px; }
  @media (max-width: 640px) {
    .mc__grade { grid-template-columns: 1fr; }
    .mc__chat { border-right: 0; border-bottom: 1px solid var(--m-linha); }
  }
</style>
