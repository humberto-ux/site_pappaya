---
import Base from '../layouts/Base.astro';
---
<Base pagina="404" titulo="Página não encontrada | Pappaya" descricao="Página não encontrada." semIndice>
  <section class="secao">
    <div class="container" style="max-width:720px;text-align:center;display:grid;gap:22px;justify-items:center">
      <p class="sobretitulo">Erro 404</p>
      <h1>Essa página não existe mais.</h1>
      <p class="lead">O site da Pappaya foi refeito e alguns endereços mudaram.</p>
      <div class="botoes" style="justify-content:center"><a class="botao botao--papaya" href="/">Ir para o início</a><a class="botao botao--contorno" href="/valentina">Conhecer a Valentina</a></div>
    </div>
  </section>
</Base>
