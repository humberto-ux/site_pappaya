---
/** Fila da recepção com um pedido de cotação completo (hotelaria). */
import Janela from './Janela.astro';
---
<Janela titulo="Fila da recepção · Unidade Praia">
  <div class="mq">
    <ul class="mq__lista">
      <li class="mq__item mq__item--ativo"><span class="m-avatar m-avatar--papaya">FC</span><div><strong>Fernanda Costa</strong><span>Cotação · sáb 22:04</span></div><span class="m-tag m-tag--ambar">Fora do horário</span></li>
      <li class="mq__item"><span class="m-avatar m-avatar--tinta">GS</span><div><strong>Guilherme Souza</strong><span>Cotação · sáb 23:17</span></div><span class="m-tag m-tag--ambar">Fora do horário</span></li>
      <li class="mq__item"><span class="m-avatar m-avatar--cinza">BA</span><div><strong>Beatriz Alves</strong><span>Dúvida · dom 07:40</span></div></li>
    </ul>
    <div class="mq__detalhe">
      <div class="mq__topo"><strong>Pedido de cotação</strong><span class="m-tag m-tag--verde">Completo</span></div>
      <dl class="mq__dados">
        <div><dt>Datas</dt><dd>12 a 15 de dezembro · 3 noites</dd></div>
        <div><dt>Ocupação</dt><dd>2 adultos e 2 crianças</dd></div>
        <div><dt>Idades das crianças</dt><dd>4 e 9 anos</dd></div>
        <div><dt>Camas</dt><dd>1 casal + 2 solteiro</dd></div>
      </dl>
      <div class="m-caixa m-ia"><span class="m-rotulo">Resumo da IA</span><p>Família de quatro pedindo preço para o feriado. Informado que a recepção envia a cotação pela manhã. Nenhuma reserva confirmada.</p></div>
      <div class="mq__acoes"><span class="mq__botao">Enviar cotação</span><span class="m-tag">Agendar retorno</span></div>
    </div>
  </div>
</Janela>
<style>
  .mq { display: grid; grid-template-columns: 0.9fr 1.1fr; min-height: 320px; }
  .mq__lista { list-style: none; margin: 0; padding: 8px; border-right: 1px solid var(--m-linha); background: var(--m-suave); display: flex; flex-direction: column; gap: 4px; }
  .mq__item { display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; align-items: center; padding: 10px; border-radius: 10px; }
  .mq__item .m-tag { grid-column: 2; justify-self: start; font-size: 10.5px; }
  .mq__item--ativo { background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.08); }
  .mq__item strong { display: block; font-size: 12.5px; }
  .mq__item span:not(.m-avatar):not(.m-tag) { font-size: 11.5px; color: var(--m-texto-2); }
  .mq__detalhe { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .mq__topo { display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
  .mq__dados { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; }
  .mq__dados div { background: var(--m-suave); border-radius: 10px; padding: 8px 10px; }
  .mq__dados dt { font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--m-texto-2); }
  .mq__dados dd { margin: 2px 0 0; font-weight: 600; font-size: 12.5px; }
  .m-ia p { margin-top: 6px; font-size: 12.5px; }
  .mq__acoes { display: flex; gap: 8px; align-items: center; }
  .mq__botao { background: var(--tinta); color: #fff; font-weight: 600; font-size: 12px; padding: 7px 12px; border-radius: 999px; }
  @media (max-width: 640px) { .mq { grid-template-columns: 1fr; } .mq__lista { border-right: 0; border-bottom: 1px solid var(--m-linha); } .mq__item:not(.mq__item--ativo) { display: none; } }
</style>
