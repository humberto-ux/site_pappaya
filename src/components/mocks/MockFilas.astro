---
/** Dois números e duas filas, ou uma central compartilhada. */
import Janela from './Janela.astro';
interface Props { titulo?: string; unidades?: [string, string] }
const { titulo = 'Números e filas', unidades = ['Unidade Centro', 'Unidade Praia'] } = Astro.props;
---
<Janela titulo={titulo}>
  <div class="mn">
    {unidades.map((u, i) => (
      <div class="mn__unidade">
        <div class="mn__cab">
          <span class:list={['mn__wa', { 'mn__wa--2': i === 1 }]}>WA</span>
          <div><strong>{u}</strong><span>{i === 0 ? '(11) 4000-0001' : '(13) 4000-0002'}</span></div>
          <span class="m-tag m-tag--verde">Conectado</span>
        </div>
        <div class="mn__fila">
          <span class="m-rotulo">Fila · {i === 0 ? 5 : 3} aguardando</span>
          {[0, 1, 2].slice(0, i === 0 ? 3 : 2).map((j) => (
            <div class="mn__linha"><i class="m-avatar m-avatar--cinza"></i><b></b><em></em></div>
          ))}
        </div>
      </div>
    ))}
    <div class="mn__ou"><span>ou</span></div>
    <div class="mn__central">
      <strong>Central compartilhada</strong>
      <span>Os dois números caem numa fila só, com a unidade marcada em cada contato.</span>
    </div>
  </div>
</Janela>
<style>
  .mn { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px; background: var(--m-suave); }
  .mn__unidade { background: #fff; border: 1px solid var(--m-linha); border-radius: 12px; overflow: hidden; }
  .mn__cab { display: flex; align-items: center; gap: 10px; padding: 12px; border-bottom: 1px solid var(--m-linha); flex-wrap: wrap; }
  .mn__cab strong { display: block; font-size: 12.5px; }
  .mn__cab span:not(.m-tag):not(.mn__wa) { font-size: 11px; color: var(--m-texto-2); }
  .mn__cab .m-tag { margin-left: auto; font-size: 10px; }
  .mn__wa { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--verde); color: #fff; font-size: 10px; font-weight: 700; }
  .mn__wa--2 { background: var(--papaya); color: var(--tinta); }
  .mn__fila { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 8px; }
  .mn__linha { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 8px; row-gap: 4px; align-items: center; }
  .mn__linha i { grid-row: span 2; width: 22px; height: 22px; }
  .mn__linha b { height: 7px; width: 70%; border-radius: 4px; background: #e5dfd4; }
  .mn__linha em { height: 6px; width: 45%; border-radius: 4px; background: #efebe3; }
  .mn__ou { grid-column: 1 / -1; display: flex; align-items: center; gap: 10px; color: var(--m-texto-2); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .mn__ou::before, .mn__ou::after { content: ''; flex: 1; height: 1px; background: var(--m-linha); }
  .mn__central { grid-column: 1 / -1; background: #fff; border: 1.5px dashed var(--linha-forte); border-radius: 12px; padding: 12px; }
  .mn__central strong { display: block; font-size: 12.5px; margin-bottom: 2px; }
  .mn__central span { font-size: 12px; color: var(--m-texto-2); }
  @media (max-width: 520px) { .mn { grid-template-columns: 1fr; } }
</style>
