---
/** Linha do tempo de um contato e lista de retornos do dia. */
import Janela from './Janela.astro';
const eventos = [
  ['19:42', 'Chegou pelo anúncio Residencial Jardins', 'papaya'],
  ['19:43', 'IA qualificou: 2 quartos, financiamento, até R$ 450 mil', 'verde'],
  ['19:44', 'Rafael assumiu a conversa', 'tinta'],
  ['19:51', 'Anotação: enviar planta e simulação', 'cinza'],
  ['Amanhã', 'Retorno agendado · 10:00', 'ambar'],
];
---
<Janela titulo="Histórico e retornos">
  <div class="ml">
    <ol class="ml__tempo">
      {eventos.map(([h, t, c]) => (
        <li><span class:list={['ml__ponto', `ml__ponto--${c}`]}></span><time>{h}</time><p>{t}</p></li>
      ))}
    </ol>
    <div class="ml__retornos">
      <span class="m-rotulo">Retornos de hoje · Rafael</span>
      <ul>
        <li><input type="checkbox" checked disabled tabindex="-1" /> Ana Duarte · confirmar visita</li>
        <li><input type="checkbox" disabled tabindex="-1" /> Jorge Lima · enviar tabela</li>
        <li><input type="checkbox" disabled tabindex="-1" /> Marina Lopes · planta e simulação</li>
      </ul>
      <div class="ml__tags"><span class="m-tag">financiamento</span><span class="m-tag">2 quartos</span></div>
    </div>
  </div>
</Janela>
<style>
  .ml { display: grid; grid-template-columns: 1.25fr 1fr; }
  .ml__tempo { list-style: none; margin: 0; padding: 16px 16px 16px 18px; position: relative; }
  .ml__tempo::before { content: ''; position: absolute; left: 22px; top: 22px; bottom: 26px; width: 1.5px; background: var(--m-linha); }
  .ml__tempo li { position: relative; display: grid; grid-template-columns: 22px 52px 1fr; align-items: baseline; padding: 6px 0; }
  .ml__ponto { width: 10px; height: 10px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px var(--m-linha); position: relative; top: 1px; }
  .ml__ponto--papaya { background: var(--papaya); } .ml__ponto--verde { background: var(--verde); } .ml__ponto--tinta { background: var(--tinta); } .ml__ponto--cinza { background: #b9b2a6; } .ml__ponto--ambar { background: #e0a830; }
  .ml__tempo time { font-size: 11px; font-weight: 600; color: var(--m-texto-2); }
  .ml__tempo p { font-size: 12.5px; }
  .ml__retornos { border-left: 1px solid var(--m-linha); background: var(--m-suave); padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .ml__retornos ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ml__retornos li { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--m-linha); border-radius: 10px; padding: 8px 10px; font-size: 12px; }
  .ml__retornos input { accent-color: var(--verde); margin: 0; }
  .ml__tags { display: flex; gap: 6px; flex-wrap: wrap; }
  @media (max-width: 560px) { .ml { grid-template-columns: 1fr; } .ml__retornos { border-left: 0; border-top: 1px solid var(--m-linha); } }
</style>
