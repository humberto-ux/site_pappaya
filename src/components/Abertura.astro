---
/** Abertura (hero) das páginas: texto à esquerda, visual à direita ou embaixo. */
interface Props { sobretitulo?: string; titulo: string; layout?: 'lado' | 'empilhado' }
const { sobretitulo, titulo, layout = 'lado' } = Astro.props;
---
<section class:list={['abertura', `abertura--${layout}`]}>
  <div class="abertura__fundo" aria-hidden="true"></div>
  <div class="container abertura__grade">
    <div class="abertura__texto">
      {sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
      <h1>{titulo}</h1>
      <p class="lead abertura__sub"><slot name="subtitulo" /></p>
      <div class="botoes"><slot name="botoes" /></div>
      <slot name="extra" />
    </div>
    <div class="abertura__visual"><slot name="visual" /></div>
  </div>
</section>
<style>
  .abertura { position: relative; overflow: hidden; padding: clamp(40px, 7vw, 88px) 0 clamp(56px, 8vw, 104px); isolation: isolate; }
  .abertura__fundo {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(900px 480px at 92% 8%, rgb(242 98 46 / 0.14), transparent 70%),
      radial-gradient(700px 420px at 70% 100%, rgb(29 107 82 / 0.08), transparent 70%);
  }
  .abertura__fundo::after {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgb(20 33 29 / 0.09) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 60%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 60%, transparent);
    opacity: 0.6;
  }
  .abertura__grade { display: grid; gap: clamp(40px, 6vw, 64px); align-items: center; }
  .abertura--lado .abertura__grade { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
  .abertura--empilhado .abertura__texto { max-width: 880px; margin-inline: auto; text-align: center; }
  .abertura--empilhado .abertura__sub { margin-inline: auto; }
  .abertura--empilhado .botoes { justify-content: center; }
  .abertura--empilhado .abertura__visual { max-width: 1040px; margin-inline: auto; width: 100%; }
  .abertura h1 { font-size: clamp(2.4rem, 4.6vw, 3.9rem); }
  .abertura--lado .abertura__texto { max-width: 640px; }
  .abertura__sub { margin: 24px 0 34px; }
  @media (max-width: 980px) {
    .abertura--lado .abertura__grade { grid-template-columns: minmax(0, 1fr); }
  }
</style>
