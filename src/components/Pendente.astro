---
/**
 * Marca uma afirmação que só pode ir ao ar depois que a equipe confirmar
 * e separar a evidência (tela, vídeo, autorização).
 * Com PUBLIC_OCULTAR_PENDENTES=true, o conteúdo some do site publicado.
 *
 * <Pendente>frase</Pendente>          frase dentro de um parágrafo
 * <Pendente bloco>...</Pendente>      bloco inteiro (passos, seções)
 */
import { ocultarPendentes } from '../config';
interface Props { bloco?: boolean; nota?: string }
const { bloco = false, nota } = Astro.props;
const titulo = nota ?? 'Prova pendente: só vai ao ar com evidência confirmada';
---
{!ocultarPendentes && (
  bloco ? (
    <div class="pendente-bloco">
      <p class="pendente-bloco__aviso"><span class="pendente-bloco__selo">Prova pendente</span>{nota ?? 'Este bloco só vai ao ar depois que a equipe confirmar a evidência.'}</p>
      <slot />
    </div>
  ) : (
    <span class="pendente" title={titulo}><slot /><span class="pendente__etiqueta" aria-label="prova pendente">P</span></span>
  )
)}
<style>
  .pendente-bloco { position: relative; border: 1.5px dashed #e0b85c; border-radius: var(--raio-lg); padding: clamp(14px, 2vw, 22px); }
  .pendente-bloco__aviso { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--ambar); margin-bottom: 18px; }
  .pendente-bloco__selo { font-weight: 800; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: var(--ambar-claro); }
  :global(.secao--tinta) .pendente-bloco__aviso { color: #f1cf86; }
</style>
